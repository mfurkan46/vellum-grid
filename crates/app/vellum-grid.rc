#include <winver.h>

1 ICON "../../assets/vellum-grid.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041F04B0"
        BEGIN
            VALUE "CompanyName", "Vellum"
            VALUE "FileDescription", "Vellum Grid"
            VALUE "ProductName", "Vellum Grid"
            VALUE "OriginalFilename", "vellum-grid.exe"
            VALUE "LegalCopyright", "MIT OR Apache-2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x041F, 1200
    END
END
